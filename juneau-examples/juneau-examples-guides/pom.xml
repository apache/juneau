<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.apache.juneau</groupId>
		<artifactId>juneau-examples</artifactId>
		<version>10.0.0-SNAPSHOT</version>
	</parent>

	<!--
		Test-only module: the code shown in the docs site's Guides (pages/guides/ in juneau-docs).  Every Java,
		configuration and POM block on a guide page is a marked region of a file here, and the docs build's
		check-guide-snippets.py fails when a page and its region differ, so the tests below are what keep the
		guides' code compiling and working.  Nothing depends on this module.  Never published.
	-->
	<artifactId>juneau-examples-guides</artifactId>
	<name>Apache Juneau Examples — Guides</name>
	<description>Apache Juneau Examples - tested code for the documentation guides (not published)</description>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<!-- Not a release artifact: no sources, javadoc, signature, install or deploy. -->
		<maven.install.skip>true</maven.install.skip>
		<maven.deploy.skip>true</maven.deploy.skip>
		<maven.source.skip>true</maven.source.skip>
		<maven.javadoc.skip>true</maven.javadoc.skip>
		<gpg.skip>true</gpg.skip>
		<!-- Same pins as juneau-examples-mcp: juneau-rest-server-auth-jwt and -oauth declare Nimbus `provided`. -->
		<nimbus-jose-jwt.version>10.9.1</nimbus-jose-jwt.version>
		<nimbus-oauth2-oidc-sdk.version>11.38.2</nimbus-oauth2-oidc-sdk.version>
	</properties>

	<dependencies>
		<!-- Guide 1: Build a REST API on Spring Boot. -->
		<dependency>
			<groupId>org.apache.juneau</groupId>
			<artifactId>juneau-rest-server-springboot</artifactId>
			<version>${project.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
			<version>${spring.version}</version>
			<scope>test</scope>
			<exclusions>
				<exclusion>
					<groupId>org.springframework.boot</groupId>
					<artifactId>spring-boot-starter-logging</artifactId>
				</exclusion>
				<exclusion>
					<groupId>org.springframework.boot</groupId>
					<artifactId>spring-boot-starter-jackson</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<!-- Guides 2, 3 and 7: MockRestClient (brings juneau-rest-server and juneau-rest-client). -->
		<dependency>
			<groupId>org.apache.juneau</groupId>
			<artifactId>juneau-rest-mock</artifactId>
			<version>${project.version}</version>
			<scope>test</scope>
		</dependency>
		<!-- Guide 4: the next-generation REST client. -->
		<dependency>
			<groupId>org.apache.juneau</groupId>
			<artifactId>juneau-rest-client</artifactId>
			<version>${project.version}</version>
			<scope>test</scope>
		</dependency>
		<!-- Guide 6: INI/YAML config and variables. -->
		<dependency>
			<groupId>org.apache.juneau</groupId>
			<artifactId>juneau-config</artifactId>
			<version>${project.version}</version>
			<scope>test</scope>
		</dependency>
		<!-- Guide 2: JWT and OAuth bearer tokens. -->
		<dependency>
			<groupId>org.apache.juneau</groupId>
			<artifactId>juneau-rest-server-auth-jwt</artifactId>
			<version>${project.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.apache.juneau</groupId>
			<artifactId>juneau-rest-server-auth-oauth</artifactId>
			<version>${project.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.nimbusds</groupId>
			<artifactId>nimbus-jose-jwt</artifactId>
			<version>${nimbus-jose-jwt.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.nimbusds</groupId>
			<artifactId>oauth2-oidc-sdk</artifactId>
			<version>${nimbus-oauth2-oidc-sdk.version}</version>
			<scope>test</scope>
		</dependency>
		<!-- Every guide's test. -->
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<version>${junit.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.apache.juneau</groupId>
			<artifactId>juneau-test-utils</artifactId>
			<version>${project.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.apache.juneau</groupId>
			<artifactId>juneau-bct</artifactId>
			<version>${project.version}</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

</project>
