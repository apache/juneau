<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.apache.juneau</groupId>
		<artifactId>juneau-petstore</artifactId>
		<version>10.0.0-SNAPSHOT</version>
	</parent>

	<artifactId>juneau-petstore-core</artifactId>
	<name>Apache Juneau Petstore Core</name>
	<description>Apache Juneau Petstore - shared domain model and REST resources</description>
	<packaging>jar</packaging>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
	</properties>

	<dependencies>
		<dependency>
			<groupId>org.apache.juneau</groupId>
			<artifactId>juneau-rest-server</artifactId>
			<version>${project.version}</version>
		</dependency>

		<!--
			View-engine bridges (pure-classpath: render identically under Jetty AND Spring Boot's
			embedded container, giving the petstore deployment-parity for the view-demo surface).
			Bridge modules only ship engine APIs in `provided` scope, so each engine dep is declared
			explicitly here.
		-->
		<dependency>
			<groupId>org.apache.juneau</groupId>
			<artifactId>juneau-rest-server-view-mustache</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>com.github.spullara.mustache.java</groupId>
			<artifactId>compiler</artifactId>
			<version>0.9.14</version>
		</dependency>
		<dependency>
			<groupId>org.apache.juneau</groupId>
			<artifactId>juneau-rest-server-view-freemarker</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>org.freemarker</groupId>
			<artifactId>freemarker</artifactId>
			<version>2.3.35</version>
		</dependency>

		<!-- Console UI: chrome, FreeMarker bridge, DataTables, views and widgets. -->
		<dependency>
			<groupId>org.apache.juneau</groupId>
			<artifactId>juneau-rest-server-console-ui</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>org.apache.juneau</groupId>
			<artifactId>juneau-rest-server-console-ui-freemarker</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>org.apache.juneau</groupId>
			<artifactId>juneau-rest-server-views</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>org.apache.juneau</groupId>
			<artifactId>juneau-rest-server-widgets</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>org.apache.juneau</groupId>
			<artifactId>juneau-rest-server-datatables</artifactId>
			<version>${project.version}</version>
		</dependency>

		<!-- Test dependencies -->
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<version>${junit.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.apache.juneau</groupId>
			<artifactId>juneau-test-utils</artifactId>
			<version>${project.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.apache.juneau</groupId>
			<artifactId>juneau-rest-mock</artifactId>
			<version>${project.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.apache.juneau</groupId>
			<artifactId>juneau-test</artifactId>
			<version>${project.version}</version>
			<scope>test</scope>
		</dependency>
		<!-- Browser tests: a real Jetty server on an ephemeral port. -->
		<dependency>
			<groupId>org.apache.juneau</groupId>
			<artifactId>juneau-microservice-jetty</artifactId>
			<version>${project.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.apache.juneau</groupId>
			<artifactId>juneau-microservice-jetty</artifactId>
			<version>${project.version}</version>
			<type>test-jar</type>
			<scope>test</scope>
		</dependency>
		<!-- PetstoreSql_Test: the SQL BeanQuery adapter over H2, compared against the in-memory store. -->
		<dependency>
			<groupId>org.apache.juneau</groupId>
			<artifactId>juneau-beanquery-sql</artifactId>
			<version>${project.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.apache.juneau</groupId>
			<artifactId>juneau-beanquery-postgres</artifactId>
			<version>${project.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<version>${h2.version}</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<profiles>
		<!--
			Browser tests: the *_BrowserTest classes drive the real console JS in headless Chromium against a live
			petstore server.  NOT activated by default; a normal build needs no Node, npm, browser or network, and the
			classes are skipped because no "juneau.jsTests" system property is set:

			    mvn -Pjs-tests -pl juneau-petstore/juneau-petstore-core -am test -Dtest='org.apache.juneau.petstore.**.*_BrowserTest' -Dsurefire.failIfNoSpecifiedTests=false

			A copy of juneau-rest-server-views' js-tests profile (see the notes there on target/js, the browser cache
			and the -Djuneau.jsTests.* overrides), with only the harness path and the npm packages changed: the
			petstore pages load jQuery and DataTables from the WebJars the console serves (WebJarsMixin).
		-->
		<profile>
			<id>js-tests</id>
			<properties>
				<!-- Keep in step with juneau-rest-server-views/pom.xml: one Playwright version, one CI cache. -->
				<playwright.version>1.49.1</playwright.version>
				<juneau.jsTests.node>node</juneau.jsTests.node>
				<juneau.jsTests.npm>npm</juneau.jsTests.npm>
				<js.tests.dir>${project.build.directory}/js</js.tests.dir>
				<juneau.jsTests.browsers>${js.tests.dir}/browsers</juneau.jsTests.browsers>
			</properties>
			<build>
				<plugins>
					<plugin>
						<groupId>org.codehaus.mojo</groupId>
						<artifactId>exec-maven-plugin</artifactId>
						<version>3.3.0</version>
						<executions>
							<execution>
								<id>js-install-playwright</id>
								<phase>process-test-classes</phase>
								<goals>
									<goal>exec</goal>
								</goals>
								<configuration>
									<executable>${juneau.jsTests.npm}</executable>
									<arguments>
										<argument>install</argument>
										<argument>--no-fund</argument>
										<argument>--no-audit</argument>
										<argument>--prefix</argument>
										<argument>${js.tests.dir}</argument>
										<argument>playwright@${playwright.version}</argument>
									</arguments>
								</configuration>
							</execution>
							<execution>
								<id>js-install-chromium</id>
								<phase>process-test-classes</phase>
								<goals>
									<goal>exec</goal>
								</goals>
								<configuration>
									<executable>${juneau.jsTests.node}</executable>
									<environmentVariables>
										<PLAYWRIGHT_BROWSERS_PATH>${juneau.jsTests.browsers}</PLAYWRIGHT_BROWSERS_PATH>
									</environmentVariables>
									<arguments>
										<argument>${js.tests.dir}/node_modules/playwright/cli.js</argument>
										<argument>install</argument>
										<argument>chromium</argument>
									</arguments>
								</configuration>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-surefire-plugin</artifactId>
						<configuration>
							<systemPropertyVariables>
								<juneau.jsTests>true</juneau.jsTests>
								<juneau.jsTests.dir>${js.tests.dir}</juneau.jsTests.dir>
								<juneau.jsTests.harness>${project.basedir}/src/test/js/petstore-browser.cjs</juneau.jsTests.harness>
								<juneau.jsTests.node>${juneau.jsTests.node}</juneau.jsTests.node>
								<juneau.jsTests.browsers>${juneau.jsTests.browsers}</juneau.jsTests.browsers>
							</systemPropertyVariables>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-source-plugin</artifactId>
				<executions>
					<execution>
						<id>attach-sources</id>
						<phase>verify</phase>
						<goals>
							<goal>jar-no-fork</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<executions>
					<execution>
						<id>default-prepare-agent</id>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<id>default-report</id>
						<phase>prepare-package</phase>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
