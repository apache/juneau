[
  {"name": "eq matches", "rules": [{"field": "status", "op": "eq", "value": "open"}], "facts": {"status": "open"}, "expected": true},
  {"name": "eq non-match", "rules": [{"field": "status", "op": "eq", "value": "open"}], "facts": {"status": "closed"}, "expected": false},
  {"name": "eq missing field fails closed", "rules": [{"field": "status", "op": "eq", "value": "open"}], "facts": {}, "expected": false},
  {"name": "ne matches when different", "rules": [{"field": "status", "op": "ne", "value": "open"}], "facts": {"status": "closed"}, "expected": true},
  {"name": "ne missing field fails closed", "rules": [{"field": "status", "op": "ne", "value": "open"}], "facts": {}, "expected": false},
  {"name": "present matches non-blank", "rules": [{"field": "name", "op": "present"}], "facts": {"name": "a"}, "expected": true},
  {"name": "present fails on blank string", "rules": [{"field": "name", "op": "present"}], "facts": {"name": "  "}, "expected": false},
  {"name": "present fails on missing", "rules": [{"field": "name", "op": "present"}], "facts": {}, "expected": false},
  {"name": "absent matches missing", "rules": [{"field": "name", "op": "absent"}], "facts": {}, "expected": true},
  {"name": "absent matches null", "rules": [{"field": "name", "op": "absent"}], "facts": {"name": null}, "expected": true},
  {"name": "absent fails when present", "rules": [{"field": "name", "op": "absent"}], "facts": {"name": "a"}, "expected": false},
  {"name": "in matches one of the values", "rules": [{"field": "status", "op": "in", "value": ["open", "acked"]}], "facts": {"status": "acked"}, "expected": true},
  {"name": "in fails when not listed", "rules": [{"field": "status", "op": "in", "value": ["open", "acked"]}], "facts": {"status": "closed"}, "expected": false},
  {"name": "in missing field fails closed", "rules": [{"field": "status", "op": "in", "value": ["open"]}], "facts": {}, "expected": false},
  {"name": "contains matches when field array contains the value", "rules": [{"field": "roles", "op": "contains", "value": "admin"}], "facts": {"roles": ["admin", "oncall"]}, "expected": true},
  {"name": "contains fails when field array lacks the value", "rules": [{"field": "roles", "op": "contains", "value": "admin"}], "facts": {"roles": ["oncall"]}, "expected": false},
  {"name": "contains fails when field is not an array", "rules": [{"field": "roles", "op": "contains", "value": "admin"}], "facts": {"roles": "admin"}, "expected": false},
  {"name": "contains missing field fails closed", "rules": [{"field": "roles", "op": "contains", "value": "admin"}], "facts": {}, "expected": false},
  {"name": "dotted path resolves nested facts", "rules": [{"field": "facts.viewer.roles", "op": "contains", "value": "admin"}], "facts": {"facts": {"viewer": {"roles": ["admin"]}}}, "expected": true},
  {"name": "dotted path missing intermediate fails closed", "rules": [{"field": "facts.viewer.roles", "op": "contains", "value": "admin"}], "facts": {"facts": {}}, "expected": false},
  {"name": "multiple rules AND together - all match", "rules": [{"field": "status", "op": "eq", "value": "open"}, {"field": "priority", "op": "in", "value": ["p1", "p2"]}], "facts": {"status": "open", "priority": "p1"}, "expected": true},
  {"name": "multiple rules AND together - one fails", "rules": [{"field": "status", "op": "eq", "value": "open"}, {"field": "priority", "op": "in", "value": ["p1", "p2"]}], "facts": {"status": "open", "priority": "p3"}, "expected": false},
  {"name": "empty rule list always matches", "rules": [], "facts": {}, "expected": true},
  {"name": "eq compares strictly - number is not its string", "rules": [{"field": "n", "op": "eq", "value": "1"}], "facts": {"n": 1}, "expected": false}
]
