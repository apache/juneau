{
	"description": "Shared same-origin path corpus. accepted: the verdict of the shared core (SafePathTemplate.isSameOriginPath, RunViewChecks, and the exact-parity JS guards). crossHost: new URL(input, base).origin differs from base, checked by same-origin-path.cjs. guards: per-guard overrides. Inputs use JSON escapes, never raw control characters.",
	"cases": [
		{
			"name": "c01-double-backslash-host",
			"input": "\\\\evil.test/x",
			"accepted": false,
			"crossHost": true
		},
		{
			"name": "c02-slash-backslash-host",
			"input": "/\\evil.test",
			"accepted": false,
			"crossHost": true
		},
		{
			"name": "c03-backslash-slash-host",
			"input": "\\/evil.test",
			"accepted": false,
			"crossHost": true
		},
		{
			"name": "c04-leading-space-protocol-relative",
			"input": " //evil.test",
			"accepted": false,
			"crossHost": true
		},
		{
			"name": "c05-leading-tab",
			"input": "\t//evil.test",
			"accepted": false,
			"crossHost": true
		},
		{
			"name": "c06-leading-lf",
			"input": "\n//evil.test",
			"accepted": false,
			"crossHost": true
		},
		{
			"name": "c07-leading-cr",
			"input": "\r//evil.test",
			"accepted": false,
			"crossHost": true
		},
		{
			"name": "c08-leading-nul",
			"input": "\u0000//evil.test",
			"accepted": false,
			"crossHost": true
		},
		{
			"name": "c09-leading-us",
			"input": "\u001f//evil.test",
			"accepted": false,
			"crossHost": true
		},
		{
			"name": "c10-inner-tab",
			"input": "/\t/evil.test",
			"accepted": false,
			"crossHost": true
		},
		{
			"name": "c11-inner-lf",
			"input": "/\n/evil.test",
			"accepted": false,
			"crossHost": true
		},
		{
			"name": "c12-nul-then-backslashes",
			"input": "\u0000\\\\evil.test",
			"accepted": false,
			"crossHost": true
		},
		{
			"name": "c13-protocol-relative",
			"input": "//evil.test",
			"accepted": false,
			"crossHost": true
		},
		{
			"name": "c14-triple-slash",
			"input": "///evil.test",
			"accepted": false,
			"crossHost": true
		},
		{
			"name": "c15-absolute-https",
			"input": "https://evil.test/x",
			"accepted": false,
			"crossHost": true,
			"guards": {
				"consoleIsSafeHref": true,
				"markdownIsSafeHref": true,
				"imageIsSafeSrc": true
			},
			"note": "the allowlist guards accept an absolute http(s) URL by design; every path guard refuses it"
		},
		{
			"name": "c16-javascript",
			"input": "javascript:alert(1)",
			"accepted": false,
			"crossHost": true
		},
		{
			"name": "c17-javascript-mixed-case",
			"input": "JaVaScRiPt:alert(1)",
			"accepted": false,
			"crossHost": true
		},
		{
			"name": "c18-javascript-tab-obfuscated",
			"input": "java\tscript:alert(1)",
			"accepted": false,
			"crossHost": true
		},
		{
			"name": "c19-data",
			"input": "data:text/html,x",
			"accepted": false,
			"crossHost": true
		},
		{
			"name": "c20-scheme-without-slashes",
			"input": "http:evil.test",
			"accepted": false,
			"crossHost": true
		},
		{
			"name": "c21-trailing-space-protocol-relative",
			"input": "//evil.test ",
			"accepted": false,
			"crossHost": true
		},
		{
			"name": "n01-trailing-space",
			"input": "/foo ",
			"accepted": false,
			"crossHost": false
		},
		{
			"name": "n02-query-backslash",
			"input": "/foo?q=C:\\x",
			"accepted": false,
			"crossHost": false
		},
		{
			"name": "n03-dot-dot-segment",
			"input": "/a/../b",
			"accepted": false,
			"crossHost": false,
			"guards": {
				"consoleIsSafeHref": true,
				"markdownIsSafeHref": true,
				"imageIsSafeSrc": true
			}
		},
		{
			"name": "n04-relative-dot-dot",
			"input": "a/../b",
			"accepted": false,
			"crossHost": false,
			"guards": {
				"consoleIsSafeHref": true,
				"markdownIsSafeHref": true,
				"imageIsSafeSrc": true
			}
		},
		{
			"name": "n05-bare-dot-dot",
			"input": "..",
			"accepted": false,
			"crossHost": false,
			"guards": {
				"consoleIsSafeHref": true,
				"markdownIsSafeHref": true,
				"imageIsSafeSrc": true
			}
		},
		{
			"name": "n06-empty",
			"input": "",
			"accepted": false,
			"crossHost": false
		},
		{
			"name": "n07-blank",
			"input": "   ",
			"accepted": false,
			"crossHost": false
		},
		{
			"name": "n08-del-char",
			"input": "/a\u007fb",
			"accepted": false,
			"crossHost": false
		},
		{
			"name": "a01-absolute-path",
			"input": "/a/b",
			"accepted": true,
			"crossHost": false
		},
		{
			"name": "a02-relative-path",
			"input": "a/b",
			"accepted": true,
			"crossHost": false
		},
		{
			"name": "a03-dot-relative",
			"input": "./a",
			"accepted": true,
			"crossHost": false
		},
		{
			"name": "a04-query-only",
			"input": "?q=1",
			"accepted": true,
			"crossHost": false
		},
		{
			"name": "a05-fragment-only",
			"input": "#frag",
			"accepted": true,
			"crossHost": false,
			"guards": {
				"imageIsSafeSrc": false,
				"isSafeLineImageSrc": false
			}
		},
		{
			"name": "a06-query-contains-double-slash",
			"input": "/a?b=//c",
			"accepted": true,
			"crossHost": false
		},
		{
			"name": "a07-template-segment",
			"input": "/{id}/x",
			"accepted": true,
			"crossHost": false,
			"guards": {
				"consoleIsSafeChromeEndpoint": false
			},
			"note": "templates are checked unexpanded; the chrome guard also forbids any placeholder"
		},
		{
			"name": "a08-template-trailing",
			"input": "/a/{id}",
			"accepted": true,
			"crossHost": false,
			"guards": {
				"consoleIsSafeChromeEndpoint": false
			}
		},
		{
			"name": "a09-encoded-backslash",
			"input": "/%5Cevil.test",
			"accepted": true,
			"crossHost": false
		},
		{
			"name": "a10-internal-space",
			"input": "/a b",
			"accepted": true,
			"crossHost": false
		},
		{
			"name": "a11-dot-then-double-slash",
			"input": "/.//evil.test",
			"accepted": true,
			"crossHost": false
		},
		{
			"name": "a12-nbsp-prefix",
			"input": "\u00a0//evil.test",
			"accepted": true,
			"crossHost": false,
			"guards": {
				"consoleIsSafeHref": false,
				"markdownIsSafeHref": false,
				"imageIsSafeSrc": false
			},
			"note": "a browser does not strip U+00A0, so this is a same-origin path; the allowlist guards trim() it and stay stricter"
		},
		{
			"name": "a13-encoded-double-slash",
			"input": "%2F%2Fevil.test",
			"accepted": true,
			"crossHost": false
		},
		{
			"name": "a14-colon-after-slash",
			"input": "/a:b",
			"accepted": true,
			"crossHost": false
		},
		{
			"name": "a15-non-ascii",
			"input": "/caf\u00e9",
			"accepted": true,
			"crossHost": false
		},
		{
			"name": "a16-https-allowlist",
			"input": "https://example.com/x",
			"accepted": false,
			"crossHost": true,
			"guards": {
				"consoleIsSafeHref": true,
				"markdownIsSafeHref": true,
				"imageIsSafeSrc": true
			},
			"note": "core rejects an absolute URL; the console, markdown and image allowlists permit absolute http(s) by design"
		}
	]
}
