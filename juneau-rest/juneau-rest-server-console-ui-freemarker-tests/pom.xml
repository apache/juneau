<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.apache.juneau</groupId>
		<artifactId>juneau-rest</artifactId>
		<version>10.0.0-SNAPSHOT</version>
	</parent>

	<!--
		Test-only module: the unit tests of juneau-rest-server-console-ui-freemarker.  They live here, not in that
		module, so nothing downstream of console-ui-freemarker (petstore-core) has to wait for them in a parallel
		reactor build: nothing depends on this module.  Tests still read the freemarker module's sources and
		target/classes through ../juneau-rest-server-console-ui-freemarker.  Never published.
	-->
	<artifactId>juneau-rest-server-console-ui-freemarker-tests</artifactId>
	<name>Apache Juneau REST Server Console UI — FreeMarker Tests</name>
	<description>Apache Juneau REST Server - unit tests for juneau-rest-server-console-ui-freemarker (not published)</description>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<freemarker.version>2.3.34</freemarker.version>
		<!-- Not a release artifact: no sources, javadoc, signature, install or deploy. -->
		<maven.install.skip>true</maven.install.skip>
		<maven.deploy.skip>true</maven.deploy.skip>
		<maven.source.skip>true</maven.source.skip>
		<maven.javadoc.skip>true</maven.javadoc.skip>
		<gpg.skip>true</gpg.skip>
	</properties>

	<dependencies>
		<dependency>
			<groupId>org.apache.juneau</groupId>
			<artifactId>juneau-rest-server-console-ui-freemarker</artifactId>
			<version>${project.version}</version>
		</dependency>
		<!-- `provided` in console-ui-freemarker, so it is not passed on; the tests render templates. -->
		<dependency>
			<groupId>org.freemarker</groupId>
			<artifactId>freemarker</artifactId>
			<version>${freemarker.version}</version>
			<scope>test</scope>
		</dependency>
		<!-- Optional in console-ui-freemarker, so it is not passed on; the "echarts" pack tests resolve its assets. -->
		<dependency>
			<groupId>org.webjars.npm</groupId>
			<artifactId>echarts</artifactId>
			<version>${webjars-echarts.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<version>${junit.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.apache.juneau</groupId>
			<artifactId>juneau-test-utils</artifactId>
			<version>${project.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.apache.juneau</groupId>
			<artifactId>juneau-rest-mock</artifactId>
			<version>${project.version}</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<executions>
					<!--
						Coverage of console-ui-freemarker's classes from these tests.  console-ui-freemarker's
						sonar.coverage.jacoco.xmlReportPaths points here.
					-->
					<execution>
						<id>report-aggregate</id>
						<phase>prepare-package</phase>
						<goals>
							<goal>report-aggregate</goal>
						</goals>
						<configuration>
							<includes>
								<include>org/apache/juneau/rest/server/view/freemarker/console/**</include>
							</includes>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
